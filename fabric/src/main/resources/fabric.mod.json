{
  "schemaVersion": 1,
  "id": "copperslug",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.copperslug.fabric.CopperSlugFabric"]
  },
  "mixins": ["copperslug.mixins.json", "copperslug.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17"
  }
}
